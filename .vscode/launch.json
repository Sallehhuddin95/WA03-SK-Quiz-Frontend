{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Next.js Dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Backend: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "D:\\Salleh Document\\Training_n_Turorial\\Web_Development\\SK_QUIZ\\WA03-SK-Quiz-Backend",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Run Frontend + Backend",
      "configurations": ["Frontend: Next.js Dev", "Backend: FastAPI (uvicorn)"],
      "stopAll": true
    }
  ]
}